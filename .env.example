# Credentials belong in your environment manager, never in Git.
# OPENAI_API_KEY or EASYAGENTIC_API_KEY must be supplied separately.
OPENAI_URL=https://api.openai.com/v1
EASYAGENTIC_MODEL=gpt-4o
EASYAGENTIC_MAX_ROUNDS=50
EASYAGENTIC_SUBAGENT_ROUNDS=30
EASYAGENTIC_MAX_TOKENS=200000
EASYAGENTIC_OUTPUT_TOKENS=2048
EASYAGENTIC_CONTEXT_TOKENS=16000
EASYAGENTIC_TASK_TIMEOUT=300
EASYAGENTIC_API_TIMEOUT=30
EASYAGENTIC_RETRIES=2
# Set current provider rates before enabling a USD limit.
EASYAGENTIC_MAX_COST_USD=0
EASYAGENTIC_INPUT_USD_PER_MILLION=0
EASYAGENTIC_OUTPUT_USD_PER_MILLION=0
EASYAGENTIC_SHELL_MODE=disabled
EASYAGENTIC_SHELL_TIMEOUT=30
EASYAGENTIC_SHELL_OUTPUT_BYTES=64000
# docker mode requires a pre-pulled repository@sha256:... image.
EASYAGENTIC_DOCKER_IMAGE=
EASYAGENTIC_TEAM_WAIT_TIMEOUT=30
EASYAGENTIC_MAX_TEAMMATES=8
EASYAGENTIC_WORKDIR=.
EASYAGENTIC_STATE_DIR=.easyagentic

# Side-effect review is mandatory; approved operations are one-use.
EASYAGENTIC_REVIEW_TIMEOUT=900
EASYAGENTIC_WRITE_LIMIT_BYTES=1048576
EASYAGENTIC_MESSAGE_LEASE=30
EASYAGENTIC_MESSAGE_ATTEMPTS=5
